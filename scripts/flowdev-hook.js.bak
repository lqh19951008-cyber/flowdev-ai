#!/bin/sh
// 2>/dev/null; exec node "$0" "$@"

/**
 * FlowDev-AI Pre-Commit Git Hook & CLI Code Review Gatekeeper
 *
 * Lightweight script using 100% native Node.js modules:
 * - Extracts staged code files via `git diff --cached`
 * - Sends staged code to FlowDev FastAPI backend (/api/cli/scan)
 * - Intercepts commit with exit code 1 if critical defects are detected
 * - Allows commit with exit code 0 if all checks & sandbox unit tests pass
 */

const { execFileSync } = require("child_process");
const http = require("http");
const https = require("https");
const fs = require("fs");
const path = require("path");

// TTY and Color detection. Strategy:
//   We default to NO ANSI COLOR for maximum compatibility:
//     * VS Code Git GUI submit panel (older versions don't render ANSI)
//     * Windows PowerShell 5.x (legacy, doesn't render \x1b)
//     * CI logs / file redirection
//     * Any pipe / non-TTY scenario
//   Instead, the hook output uses ASCII rule lines + emoji + bold headers
//   which read clearly in every environment.
//   To opt back into ANSI colors, set FLOWDEV_COLOR=1 (or FORCE_COLOR=1).
const isPowerShellLegacy = process?.platform === "win32"
  && !!process?.env?.PSExecutionPolicyPreference
  && !process?.env?.PSStyle;
const wantColor = (process?.env?.FLOWDEV_COLOR && process?.env?.FLOWDEV_COLOR !== "0")
  || (process?.env?.FORCE_COLOR && process?.env?.FORCE_COLOR !== "0");
const isColorSupported = Boolean(
  wantColor &&
  !process?.env?.NO_COLOR &&
  process?.env?.TERM !== "dumb" &&
  !isPowerShellLegacy &&
  process?.stdout?.isTTY === true
);

const c = {
  reset: isColorSupported ? "\x1b[0m" : "",
  bold: isColorSupported ? "\x1b[1m" : "",
  dim: isColorSupported ? "\x1b[2m" : "",
  red: isColorSupported ? "\x1b[31m" : "",
  green: isColorSupported ? "\x1b[32m" : "",
  yellow: isColorSupported ? "\x1b[33m" : "",
  cyan: isColorSupported ? "\x1b[36m" : "",
  blue: isColorSupported ? "\x1b[34m" : "",
  magenta: isColorSupported ? "\x1b[35m" : "",
  bgRed: isColorSupported ? "\x1b[41m" : "",
  bgGreen: isColorSupported ? "\x1b[42m" : "",
};

const SERVER_URL =
  process?.env?.FLOWDEV_SERVER_URL ||
  `http://${process?.env?.FLOWDEV_HOST || "127.0.0.1"}:${process?.env?.FLOWDEV_PORT || 8000}`;
const API_PATH = "/api/cli/scan";

// === HOOK VERSION (auto-upgrade) ===
// Bump this constant whenever flowdev-hook.js changes incompatibly.
// The hook fetches /api/hook/version on each startup; if the server's
// version is newer, it transparently downloads the new script, backs up
// the current one to .git/flowdev/.hook-version.bak, and re-execs itself.
// This is how we ship upgrades without admins running `cp` everywhere.
const HOOK_VERSION = "2.0.4";
// == HANDBOOK: push-mode ==
//
// 服务端升级规则后, **主动下发**到所有本地仓库, 开发者下次 commit 自动同步。
//
// 触发点: `POST /api/projects/{id}/push` 或 `apply` 操作自动伴随推送。
// 拉取点: hook 启动时调 `GET /api/projects/{id}/sync-status` 检查 pending。
// 应用点: 开发者 commit 时被询问 Y/n, 按 Y 后写入 8 个 IDE 规则文件 + ack。
//
// 可用端点:
//   GET    /sync-status       查询推送状态
//   POST   /push              手动推送 (仅给服务端触发)
//   POST   /ack-push          本地确认应用
//   POST   /cancel-push       本地拒绝 (pending 清空, 不再打扰)
//   PUT    /push-enabled      启用/关闭项目推送
//
// 关闭推送 (三层任选):
//   - 环境变量: `FLOWDEV_DISABLE_PUSH=1`
//   - 仓库级: `git config flowdev.pushmode false`
//   - 项目级: Web 端切换 push_enabled = false
// == /HANDBOOK ==

const HOOK_VERSION_API = "/api/hook/version";

// Set UTF-8 encoding for standard outputs if available
if (process?.stdout?.setEncoding) {
  try {
    process.stdout.setEncoding("utf-8");
  } catch (e) {}
}

function gitExec(args, options = {}) {
  return execFileSync("git", args, {
    encoding: "utf-8",
    stdio: ["pipe", "pipe", "ignore"],
    ...options,
  }).trim();
}

function safeGitExec(args, fallback = "") {
  try {
    return gitExec(args);
  } catch (e) {
    return fallback;
  }
}

function getGitRoot() {
  const root = safeGitExec(["rev-parse", "--show-toplevel"], process.cwd());
  return path.resolve(root || process.cwd());
}

function logBypassAudit(reason, user = "developer") {
  try {
    const gitRoot = getGitRoot();
    const logPath = path.join(gitRoot, ".flowdev-bypass.log");
    const timestamp = new Date().toISOString();
    const commitHash = safeGitExec(["rev-parse", "--short", "HEAD"], "uncommitted");
    const logLine = `[${timestamp}] User="${user}" Reason="${reason}" Commit="${commitHash}"\n`;
    fs.appendFileSync(logPath, logLine, "utf8");
  } catch (e) {}
}

function printBanner() {
  if (isColorSupported) {
    console.log("\n" + c.cyan + c.bold + "================================================================" + c.reset);
    console.log(c.cyan + c.bold + " [FlowDev-AI] Pre-Commit Guard 代码安全门禁" + c.reset);
    console.log(c.dim + " 基于 ReviewAgent 与 TestAgent 沙箱闭环的代码安全门禁" + c.reset);
    console.log(c.cyan + c.bold + "================================================================" + c.reset);
  }
}

const IGNORED_DIR_PATTERNS = [
  /(?:^|[\\/])node_modules(?:[\\/]|$)/i,
  /(?:^|[\\/])dist(?:[\\/]|$)/i,
  /(?:^|[\\/])build(?:[\\/]|$)/i,
  /(?:^|[\\/])out(?:[\\/]|$)/i,
  /(?:^|[\\/])\.next(?:[\\/]|$)/i,
  /(?:^|[\\/])coverage(?:[\\/]|$)/i,
  /(?:^|[\\/])__pycache__(?:[\\/]|$)/i,
  /(?:^|[\\/])\.pytest_cache(?:[\\/]|$)/i,
  /(?:^|[\\/])\.venv(?:[\\/]|$)/i,
  /(?:^|[\\/])venv(?:[\\/]|$)/i,
  /(?:^|[\\/])env(?:[\\/]|$)/i,
  /(?:^|[\\/])\.agents?(?:[\\/]|$)/i,
  /(?:^|[\\/])\.gemini(?:[\\/]|$)/i,
  /(?:^|[\\/])vendor(?:[\\/]|$)/i,
  /(?:^|[\\/])third_party(?:[\\/]|$)/i,
  /(?:^|[\\/])\.idea(?:[\\/]|$)/i,
  /(?:^|[\\/])\.vscode(?:[\\/]|$)/i,
  /(?:^|[\\/])\.turbo(?:[\\/]|$)/i,
  /(?:^|[\\/])\.cache(?:[\\/]|$)/i,
  /(?:^|[\\/])temp(?:[\\/]|$)/i,
  /(?:^|[\\/])tmp(?:[\\/]|$)/i,
  /(?:^|[\\/])output(?:[\\/]|$)/i,
];

const IGNORED_FILE_PATTERNS = [
  /\.d\.ts$/i,
  /\.d\.ts\.map$/i,
  /\.min\.(js|jsx|ts|tsx)$/i,
  /\.bundle\.js$/i,
  /\.chunk\.js$/i,
  /\.generated\.(js|ts|py|go|java)$/i,
  /\.pb\.(go|py|cc|h)$/i,
  /\.snap$/i,
  /next-env\.d\.ts$/i,
];

function isIgnoredPath(filePath) {
  if (!filePath) return true;
  const normalized = filePath.replace(/\\/g, "/");
  for (const pattern of IGNORED_DIR_PATTERNS) {
    if (pattern.test(normalized)) return true;
  }
  for (const pattern of IGNORED_FILE_PATTERNS) {
    if (pattern.test(normalized)) return true;
  }
  return false;
}

function getStagedCodeFiles() {
  try {
    const output = gitExec(["diff", "--cached", "--name-only", "--diff-filter=ACM"]);
    const lines = output
      .split("\n")
      .map((f) => f?.trim() ?? "")
      .filter(Boolean);

    // Filter relevant code files while excluding ignored dirs and generated/bundle/declaration files
    const codeExts = /\.(js|jsx|ts|tsx|py|go|java)$/i;
    return lines.filter((file) => codeExts.test(file) && !isIgnoredPath(file));
  } catch (e) {
    return [];
  }
}

function getStagedContent(filepath) {
  try {
    return execFileSync("git", ["show", ":" + filepath], {
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "ignore"],
    });
  } catch (err) {
    // Fallback to reading file from disk with path boundary security check
    const gitRoot = getGitRoot();
    const resolved = path.resolve(gitRoot, filepath);
    if (!resolved.startsWith(gitRoot)) {
      throw new Error(`[FlowDev Security] 阻止非法路径越界读取: ${filepath}`);
    }
    return fs.readFileSync(resolved, "utf-8");
  }
}

// =============================================================================
//  AI Auto-Apply: For each staged file, ask the backend LLM to rewrite it
//  according to the given suggestions, then write back + git-add. This is the
//  one-step "press Y to let AI refactor your code" UX. Failures fall back to
//  the original content so commits never break.
// =============================================================================

async function applySuggestionsToFiles(filePaths, suggestions, projectId) {
  if (!filePaths || filePaths.length === 0 || !suggestions || suggestions.length === 0) {
    return { rewritten: 0, skipped: 0 };
  }

  // Only rewrite files mentioned by suggestions. Suggestions look like
  // "[file.py] 建议..." — extract the prefix; files without a prefix are
  // applied to ALL staged files.
  const matchedByPath = new Map();
  const globalSuggestions = [];
  for (const sug of suggestions) {
    const m = String(sug).match(/^\s*\[([^\]]+)\]\s*(.*)$/);
    if (m) {
      const path = m[1];
      const body = m[2];
      if (!matchedByPath.has(path)) matchedByPath.set(path, []);
      matchedByPath.get(path).push(`${path}: ${body}`);
    } else {
      globalSuggestions.push(String(sug));
    }
  }

  let rewritten = 0;
  let skipped = 0;
  console.log("");
  console.log(`${c.cyan}${c.bold}[FlowDev-AI Auto-Apply] 调用 AI 重写文件...${c.reset}`);

  for (const rel of filePaths) {
    const fileSuggestions = [
      ...(matchedByPath.get(rel) || []),
      ...globalSuggestions,
    ];
    if (fileSuggestions.length === 0) continue;

    let originalContent;
    try {
      originalContent = getStagedContent(rel);
    } catch (e) {
      console.log(`${c.yellow}  ⚠ [${rel}] 读取失败, 跳过: ${e?.message ?? e}${c.reset}`);
      skipped++;
      continue;
    }
    if (!originalContent || !originalContent.trim()) {
      skipped++;
      continue;
    }

    let resp;
    try {
      resp = await postJson(SERVER_URL, "/api/cli/apply-suggestions", {
        project_id: projectId,
        file_path: rel,
        original_content: originalContent,
        suggestions: fileSuggestions,
        language: "auto",
      }, { timeoutMs: 180000 });
    } catch (e) {
      console.log(`${c.yellow}  ⚠ [${rel}] AI 调用失败, 保留原代码: ${e?.message ?? e}${c.reset}`);
      skipped++;
      continue;
    }

    if (!resp || !resp.modified_content || resp.modified_content === originalContent) {
      console.log(`${c.dim}  – [${rel}] AI 未能应用建议, 保留原代码${c.reset}`);
      skipped++;
      continue;
    }

    // Write back to disk with path-boundary safety
    const gitRoot = getGitRoot();
    const abs = path.resolve(gitRoot, rel);
    if (!abs.startsWith(gitRoot)) {
      console.log(`${c.red}  ✗ [${rel}] 路径越界, 拒绝写入${c.reset}`);
      skipped++;
      continue;
    }
    try {
      fs.writeFileSync(abs, resp.modified_content, "utf-8");
      // git add so the rewritten content goes in with this commit
      execFileSync("git", ["add", "--", rel], { cwd: gitRoot, stdio: ["pipe", "pipe", "ignore"] });
      rewritten++;
      const applied = (resp.applied_suggestions || []).length;
      console.log(`${c.green}  ✓ [${rel}] AI 已重写 (应用 ${applied} 项建议) — ${resp.diff_summary || ""}${c.reset}`);
    } catch (e) {
      console.log(`${c.red}  ✗ [${rel}] 写入失败: ${e?.message ?? e}${c.reset}`);
      skipped++;
    }
  }

  console.log("");
  if (rewritten > 0) {
    console.log(`${c.green}${c.bold}✨ AI Auto-Apply 完成: 重写 ${rewritten} 个文件, 跳过 ${skipped} 个${c.reset}`);
  } else {
    console.log(`${c.yellow}[FlowDev-AI Auto-Apply] 未修改任何文件${c.reset}`);
  }
  return { rewritten, skipped };
}

async function postJson(serverUrl, endpoint, data, opts = {}) {
  const timeoutMs = opts.timeoutMs ?? parseInt(process?.env?.FLOWDEV_HTTP_TIMEOUT ?? "30000", 10);  // default 30s; callers or FLOWDEV_HTTP_TIMEOUT can override
  const fullUrl = (serverUrl?.replace(/\/+$/, "") ?? "") + endpoint;

  // Always use the built-in http module. The native global fetch (Node 18+)
  // has shown "fetch failed" inside VS Code GUI child processes on Windows
  // where proxy / sandbox env vars block the request. http is predictable.

  const isHttps = fullUrl.startsWith("https:");
  const client = isHttps ? https : http;
  const parsed = new URL(fullUrl);

  return new Promise((resolve, reject) => {
    const payload = JSON.stringify(data ?? {});
    const req = client.request(
      {
        protocol: parsed.protocol,
        hostname: parsed.hostname,
        port: parsed.port || (isHttps ? 443 : 80),
        path: (parsed.pathname ?? "") + (parsed.search ?? ""),
        method: "POST",
        headers: {
          "Content-Type": "application/json; charset=utf-8",
          "Content-Length": Buffer.byteLength(payload, "utf-8"),
        },
        timeout: timeoutMs,
      },
      (res) => {
        let body = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => (body += chunk));
        res.on("end", () => {
          if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {
            try {
              resolve(JSON.parse(body));
            } catch (e) {
              reject(new Error("无法解析后端门禁返回的 JSON 响应"));
            }
          } else {
            reject(
              new Error(
                `后端服务响应错误 [HTTP ${res.statusCode}]: ${body || res.statusMessage}`
              )
            );
          }
        });
      }
    );

    req.on("error", (err) => {
      reject(err);
    });

    req.on("timeout", () => {
      req.destroy();
      reject(new Error("请求后端门禁服务超时 (30s)"));
    });

    req.write(payload, "utf-8");
    req.end();
  });
}

// Diagnostic helper for "fetch failed" troubleshooting: tests both
// transport layers and reports which one works. Used when postJson
// throws so the user knows whether their environment has a real
// connectivity issue vs. a Node-version quirk.
async function diagnoseTransport(serverUrl) {
  const url = serverUrl.replace(/\/+$/, "") + "/api/health";
  try {
    await fetchText(url, 3000);
    return { http_module: "ok" };
  } catch (e) {
    return { http_module: "fail", error: String(e?.message ?? e) };
  }
}

function fetchText(urlStr, timeoutMs = 10000) {
  return new Promise((resolve, reject) => {
    const parsed = new URL(urlStr);
    const transport = parsed.protocol === "https:" ? https : http;
    const req = transport.request(
      {
        hostname: parsed.hostname,
        port: parsed.port || (parsed.protocol === "https:" ? 443 : 80),
        path: (parsed.pathname ?? "") + (parsed.search ?? ""),
        method: "GET",
        timeout: timeoutMs,
      },
      (res) => {
        let body = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => (body += chunk));
        res.on("end", () => {
          if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {
            resolve(body);
          } else {
            reject(new Error(`HTTP ${res.statusCode}: ${body || res.statusMessage}`));
          }
        });
      }
    );
    req.on("error", reject);
    req.on("timeout", () => {
      req.destroy();
      reject(new Error("请求超时 (" + Math.round(timeoutMs/1000) + "s) — 后端 AI 调用可能较慢, 可设置 FLOWDEV_HTTP_TIMEOUT=180 提高超时"));
    });
    req.end();
  });
}

function mergeWithMarker(filePath, newBlockContent, startMarker = "<!-- FLOWDEV_RULES_START -->", endMarker = "<!-- FLOWDEV_RULES_END -->") {
  const wrappedContent = `${startMarker}\n${newBlockContent?.trim() ?? ""}\n${endMarker}`;
  if (!fs.existsSync(filePath)) {
    fs.writeFileSync(filePath, wrappedContent + "\n", "utf8");
    return "新建并写入";
  }

  const existing = fs.readFileSync(filePath, "utf8");
  const startIndex = existing.indexOf(startMarker);
  const endIndex = existing.indexOf(endMarker);

  if (startIndex !== -1 && endIndex !== -1 && endIndex > startIndex) {
    const before = existing.substring(0, startIndex).trimEnd();
    const after = existing.substring(endIndex + endMarker.length).trimStart();
    const result = (before ? before + "\n\n" : "") + wrappedContent + (after ? "\n\n" + after : "") + "\n";
    fs.writeFileSync(filePath, result, "utf8");
    return "增量更新 (精准刷新 FlowDev 标记块，完全保留用户其他手写配置)";
  } else {
    // Non-destructive append preserving all developer's custom instructions
    const result = existing.trimEnd() + "\n\n" + wrappedContent + "\n";
    fs.writeFileSync(filePath, result, "utf8");
    return "增量追加 (在文件末尾追加门禁规范，完全保留原有内容)";
  }
}

async function performSync(targetProject, gitRoot) {
  /**
   * Core sync routine shared by the manual `sync-skills` CLI and the
   * auto-detected push-mode prompt. Returns a list of files that were created
   * or updated so the caller can `git add` them and report back to the server.
   *
   * This function never `process.exit`s on its own; it returns the result and
   * lets the caller decide what to do (commit, ack, etc.).
   */
  const filesWritten = [];

  // 1. Antigravity Skill (.agents/skills/flowdev-quality/SKILL.md & .agent/skills/flowdev-quality/SKILL.md)
  const agySkillContent = await fetchText(`${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/skills/export?format=antigravity_skill`);
  const agySkillDirs = [
    path.join(gitRoot, ".agent", "skills", "flowdev-quality"),
    path.join(gitRoot, ".agents", "skills", "flowdev-quality"),
  ];
  for (const dir of agySkillDirs) {
    fs.mkdirSync(dir, { recursive: true });
    const skillPath = path.join(dir, "SKILL.md");
    fs.writeFileSync(skillPath, agySkillContent, "utf8");
    filesWritten.push(skillPath);
    console.log(`  ${c.green}✓ [模块化技能] Antigravity 技能库:${c.reset} ${skillPath}`);
  }

  // 2. Antigravity Project Rules (GEMINI.md & AGENTS.md & .agents/rules/flowdev-quality.md)
  const agyRuleContent = await fetchText(`${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/skills/export?format=gemini_md`);
  const geminiPath = path.join(gitRoot, "GEMINI.md");
  const agentsPath = path.join(gitRoot, "AGENTS.md");
  const gMode = mergeWithMarker(geminiPath, agyRuleContent);
  const aMode = mergeWithMarker(agentsPath, agyRuleContent);
  filesWritten.push(geminiPath, agentsPath);
  console.log(`  ${c.green}✓ [增量合并] Antigravity 规则文件:${c.reset} ${geminiPath} (${gMode})`);
  console.log(`  ${c.green}✓ [增量合并] Antigravity 规则文件:${c.reset} ${agentsPath} (${aMode})`);

  const agyRulesDir = path.join(gitRoot, ".agents", "rules");
  fs.mkdirSync(agyRulesDir, { recursive: true });
  const agyRulesFile = path.join(agyRulesDir, "flowdev-quality.md");
  fs.writeFileSync(agyRulesFile, agyRuleContent, "utf8");
  filesWritten.push(agyRulesFile);
  console.log(`  ${c.green}✓ [独立规则] Antigravity 规则库:${c.reset} ${agyRulesFile}`);

  // 3. Cursor (.cursorrules & .cursor/rules/flowdev-guards.mdc)
  const cursorRulesContent = await fetchText(`${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/skills/export?format=cursorrules`);
  const cursorPath = path.join(gitRoot, ".cursorrules");
  const cMode = mergeWithMarker(cursorPath, cursorRulesContent, "<!-- FLOWDEV_AI_RULES_START -->", "<!-- FLOWDEV_AI_RULES_END -->");
  filesWritten.push(cursorPath);
  console.log(`  ${c.green}✓ [增量合并] Cursor 规范文件:${c.reset} ${cursorPath} (${cMode})`);

  // 4. Claude Code (CLAUDE.md)
  const claudeContent = await fetchText(`${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/skills/export?format=claude_md`);
  const claudePath = path.join(gitRoot, "CLAUDE.md");
  const clMode = mergeWithMarker(claudePath, claudeContent);
  filesWritten.push(claudePath);
  console.log(`  ${c.green}✓ [增量合并] Claude Code 指南:${c.reset} ${claudePath} (${clMode})`);

  // 5. GitHub Copilot instructions if .github exists
  const githubDir = path.join(gitRoot, ".github");
  if (fs.existsSync(githubDir)) {
    const copilotContent = await fetchText(`${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/skills/export?format=copilot`);
    const copilotPath = path.join(githubDir, "copilot-instructions.md");
    const cpMode = mergeWithMarker(copilotPath, copilotContent);
    filesWritten.push(copilotPath);
    console.log(`  ${c.green}✓ [增量合并] Copilot 指令:${c.reset} ${copilotPath} (${cpMode})`);
  }

  // 6. Windsurf rules (.windsurfrules)
  const windsurfPath = path.join(gitRoot, ".windsurfrules");
  const wMode = mergeWithMarker(windsurfPath, cursorRulesContent, "<!-- FLOWDEV_AI_RULES_START -->", "<!-- FLOWDEV_AI_RULES_END -->");
  filesWritten.push(windsurfPath);
  console.log(`  ${c.green}✓ [增量合并] Windsurf 规范:${c.reset} ${windsurfPath} (${wMode})`);

  return filesWritten;
}

async function syncSkills() {
  const { projectId } = getGitMetadata();
  const targetProject = process?.env?.FLOWDEV_PROJECT_ID || projectId || "rxjs";
  const gitRoot = getGitRoot();

  console.log(`\n${c.cyan}${c.bold}================================================================${c.reset}`);
  console.log(`${c.cyan}${c.bold} [FlowDev-AI] 正在增量同步仓库 '${targetProject}' 的 Agent Skills 与规则...${c.reset}`);
  console.log(`${c.dim} 门禁中台: ${SERVER_URL} (无损合并模式 · 保护开发者原有配置)${c.reset}`);
  console.log(`${c.cyan}${c.bold}================================================================${c.reset}\n`);

  try {
    const filesWritten = await performSync(targetProject, gitRoot);
    console.log(`\n${c.green}${c.bold}✨ 增量同步完成！共更新 ${filesWritten.length} 个文件。${c.reset}`);
    console.log(`${c.dim}提示: 新旧 Skill 完美共存，既累加了最新防御规则，又完整保留了你原本手写的指令与配置。${c.reset}\n`);
    process.exit(0);
  } catch (err) {
    console.error(`\n${c.red}[错误] 同步 Agent Skills 失败: ${err?.message ?? err}${c.reset}\n`);
    process.exit(1);
  }
}

function getGitMetadata() {
  try {
    const toplevel = getGitRoot();
    const branch = safeGitExec(["rev-parse", "--abbrev-ref", "HEAD"], "main");
    const committer = safeGitExec(["config", "user.name"], "developer");
    const committerEmail = safeGitExec(["config", "user.email"], "");
    const fullCommitter = committerEmail ? `${committer} <${committerEmail}>` : committer;
    const projectId = path.basename(toplevel) || "unknown";
    return { projectId, branch, committer: fullCommitter };
  } catch (e) {
    return { projectId: "default-project", branch: "main", committer: "developer" };
  }
}

// ===================== Push Mode helpers =====================
function getFlowDevLocalDir() {
  const gitRoot = getGitRoot();
  // .git/flowdev/ is local-only metadata that never gets committed. We keep
  // it under .git/ so it never leaks into git status and never gets indexed.
  const dir = path.join(gitRoot, ".git", "flowdev");
  try {
    fs.mkdirSync(dir, { recursive: true });
  } catch (e) {}
  return dir;
}

// =============================================================================
//  User Preferences: load once at startup so commit can be fully automatic.
//  Read order (later wins): env vars < git config (local) < .git/flowdev/.config.json
//
//  First-run UX is "ask once, remember forever":
//   1. On first commit, hook detects missing preferences
//   2. Runs --setup wizard: ask 1-3 yes/no questions
//   3. Persists to .git/flowdev/.config.json
//   4. From then on, zero prompts — push, upgrade, gatekeeping are all silent
// =============================================================================

function loadPreferences() {
  const prefs = {
    pushAutoApply: false,        // default safe = still ask
    pushEnabled: true,            // default = push mode on
    autoUpgrade: true,            // default = auto-upgrade hook
    strictOffline: false,         // default = fail-open when backend down
    suggestionsAutoApply: false,  // default = ask before AI rewrites files
  };
  // Env vars win for CI / scripting
  if (process?.env?.FLOWDEV_PUSH_AUTOAPPLY === "1") prefs.pushAutoApply = true;
  if (process?.env?.FLOWDEV_PUSH_AUTOAPPLY === "0") prefs.pushAutoApply = false;
  if (process?.env?.FLOWDEV_DISABLE_PUSH === "1") prefs.pushEnabled = false;
  if (process?.env?.FLOWDEV_AUTO_UPGRADE === "0") prefs.autoUpgrade = false;
  if (process?.env?.FLOWDEV_STRICT === "1") prefs.strictOffline = true;
  // Git config (per-repo, checked-in via local)
  const gc = (k, fallback) => {
    try {
      const r = safeGitExec(["config", "--get", k], "");
      return r && r.length > 0 ? r : fallback;
    } catch (e) { return fallback; }
  };
  const pAuto = gc("flowdev.push.autoapply", "");
  if (pAuto === "true" || pAuto === "1" || pAuto === "yes") prefs.pushAutoApply = true;
  if (pAuto === "false" || pAuto === "0" || pAuto === "no") prefs.pushAutoApply = false;
  if (gc("flowdev.pushmode", "") === "false" || gc("flowdev.pushmode", "") === "off") prefs.pushEnabled = false;
  if (gc("flowdev.upgrade.auto", "") === "false") prefs.autoUpgrade = false;
  if (gc("flowdev.strict", "") === "true") prefs.strictOffline = true;
  const sAuto = gc("flowdev.suggestions.autoapply", "");
  if (sAuto === "true" || sAuto === "1" || sAuto === "yes") prefs.suggestionsAutoApply = true;
  if (sAuto === "false" || sAuto === "0" || sAuto === "no") prefs.suggestionsAutoApply = false;
  // .config.json file (personal, never committed)
  try {
    const cfgFile = path.join(getGitRoot(), ".git", "flowdev", ".config.json");
    if (fs.existsSync(cfgFile)) {
      const cfg = JSON.parse(fs.readFileSync(cfgFile, "utf-8"));
      if (typeof cfg?.push?.autoApply === "boolean") prefs.pushAutoApply = cfg.push.autoApply;
      if (typeof cfg?.push?.enabled === "boolean") prefs.pushEnabled = cfg.push.enabled;
      if (typeof cfg?.upgrade?.auto === "boolean") prefs.autoUpgrade = cfg.autoUpgrade;
      if (typeof cfg?.strict?.offline === "boolean") prefs.strictOffline = cfg.strict.offline;
      if (typeof cfg?.suggestions?.autoApply === "boolean") prefs.suggestionsAutoApply = cfg.suggestions.autoApply;
    }
  } catch (e) {}
  return prefs;
}

function savePreferences(patch) {
  const dir = path.join(getGitRoot(), ".git", "flowdev");
  try { fs.mkdirSync(dir, { recursive: true }); } catch (e) {}
  const cfgFile = path.join(dir, ".config.json");
  let cur = {};
  try {
    if (fs.existsSync(cfgFile)) cur = JSON.parse(fs.readFileSync(cfgFile, "utf-8"));
  } catch (e) {}
  // Deep-merge the patch
  const merged = { ...cur };
  for (const k of Object.keys(patch || {})) {
    if (typeof patch[k] === "object" && patch[k] !== null) {
      merged[k] = { ...(cur[k] || {}), ...patch[k] };
    } else {
      merged[k] = patch[k];
    }
  }
  try {
    fs.writeFileSync(cfgFile, JSON.stringify(merged, null, 2), "utf-8");
    return true;
  } catch (e) {
    return false;
  }
}

async function runSetupWizard() {
  console.log("");
  console.log(`${c.cyan}${c.bold}╔════════════════════════════════════════════════════════════════╗${c.reset}`);
  console.log(`${c.cyan}${c.bold}║  ${c.reset}${c.bgCyan}${c.bold}  FlowDev-AI 首次配置  ${c.reset}${c.cyan}${c.bold}                                          ║${c.reset}`);
  console.log(`${c.cyan}${c.bold}║  回答 1 个问题, 后续 commit / 推送 / 升级 全部自动运行             ${c.cyan}${c.bold}║${c.reset}`);
  console.log(`${c.cyan}${c.bold}╚════════════════════════════════════════════════════════════════╝${c.reset}`);
  console.log("");
  console.log(`${c.dim}什么是 Push 模式?${c.reset}`);
  console.log(`  ${c.cyan}守门员升级规则 → 自动应用到本地 IDE 规则文件 (AGENTS.md / .cursorrules / SKILL.md)${c.reset}`);
  console.log(`  ${c.cyan}            → 团队所有成员下次 commit 同步生效${c.reset}`);
  console.log(`  ${c.dim}默认安全设置: 遇到新规则时会询问你是否应用, 拒绝后将不再询问。${c.reset}`);
  console.log("");

  const ans = await promptYesNo(
    `是否开启 "全自动应用" 模式 (以后服务端推送会无任何询问直接应用)?`,
    false,  // default = ask each time (safer)
    30000
  );

  if (ans) {
    savePreferences({ push: { autoApply: true, enabled: true }, upgrade: { auto: true } });
    console.log("");
    console.log(`${c.green}${c.bold}✓ 已启用全自动模式!${c.reset}`);
    console.log(`${c.dim}  服务端推送 / hook 升级 / 门禁检查 均无任何询问, commit 零摩擦。${c.reset}`);
    console.log(`${c.dim}  后续改请恢复后运行: ${c.cyan}node .git/hooks/pre-commit --config${c.reset}`);
  } else {
    savePreferences({ push: { autoApply: false, enabled: true }, upgrade: { auto: true } });
    console.log("");
    console.log(`${c.green}${c.bold}✓ 已启用安全模式!${c.reset}`);
    console.log(`${c.dim}  遇到新规则时仍会询问 Y/n (默认 Y, 你可随时按 n)。${c.reset}`);
    console.log(`${c.dim}  以后想切换到全自动: ${c.cyan}node .git/hooks/pre-commit --config${c.reset}`);
  }
  console.log("");
  // Re-load and re-run main with new prefs
  return loadPreferences();
}

function getFlowDevRepoRoot() {
  if (process?.env?.FLOWDEV_REPO_ROOT) return process.env.FLOWDEV_REPO_ROOT;
  try {
    return path.resolve(__dirname, "..");
  } catch (e) {
    return process.cwd();
  }
}

function readLocalVersion() {
  try {
    const file = path.join(getFlowDevLocalDir(), ".local-version");
    if (!fs.existsSync(file)) return "0.0.0";
    return (fs.readFileSync(file, "utf8") || "0.0.0").trim() || "0.0.0";
  } catch (e) {
    return "0.0.0";
  }
}

function writeLocalVersion(version) {
  try {
    const file = path.join(getFlowDevLocalDir(), ".local-version");
    fs.writeFileSync(file, String(version || "0.0.0").trim(), "utf8");
  } catch (e) {}
}

function compareSemver(a, b) {
  const parse = (v) =>
    String(v || "0.0.0")
      .replace(/^v/i, "")
      .split(".")
      .map((n) => parseInt(n, 10) || 0);
  const [a1, a2, a3] = parse(a);
  const [b1, b2, b3] = parse(b);
  if (a1 !== b1) return a1 - b1;
  if (a2 !== b2) return a2 - b2;
  return a3 - b3;
}

async function fetchSyncStatus(targetProject, localVersion) {
  const url = `${SERVER_URL}/api/projects/${encodeURIComponent(targetProject)}/sync-status?local_version=${encodeURIComponent(localVersion || "0.0.0")}`;
  return await fetchJson(url);
}

async function fetchJson(urlStr) {
  const text = await fetchText(urlStr);
  try {
    return JSON.parse(text);
  } catch (e) {
    throw new Error(`无法解析后端返回的 JSON: ${text?.slice(0, 200) ?? "(empty)"}`);
  }
}

async function postJsonRaw(urlStr, body) {
  return await postJson(urlStr, "", body);
}

function promptYesNo(question, defaultYes = true, timeoutMs = 12000) {
  return new Promise((resolve) => {
    const suffix = defaultYes ? " [Y/n]" : " [y/N]";
    if (!process?.stdin?.isTTY || !process?.stdout?.isTTY) {
      // Non-TTY (VS Code GUI commit, CI, etc.): silently adopt the default
      // so we never block the user. Surface a one-line hint so they can opt
      // in manually next time if needed.
      console.log(`${c.dim}[FlowDev-Push] ${question}${suffix} ${c.reset}${c.yellow}→ (non-TTY, 默认 ${defaultYes ? "Y" : "N"})${c.reset}`);
      resolve(defaultYes);
      return;
    }

    process.stdout.write(`${c.bold}${c.cyan}? ${question}${c.reset}${suffix} `);

    let answered = false;
    const finish = (val) => {
      if (answered) return;
      answered = true;
      try {
        process.stdin.removeAllListeners("data");
        process.stdin.removeAllListeners("error");
        process.stdin.pause();
      } catch (e) {}
      resolve(val);
    };

    const onData = (chunk) => {
      const s = chunk?.toString?.() ?? "";
      const first = s.trim().toLowerCase().charAt(0);
      if (first === "y") {
        process.stdout.write("\n");
        finish(true);
      } else if (first === "n") {
        process.stdout.write("\n");
        finish(false);
      } else if (s.includes("\n") || s.includes("\r")) {
        // Enter pressed without input -> adopt default
        process.stdout.write("\n");
        finish(defaultYes);
      }
    };

    try {
      process.stdin.resume();
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", onData);
      process.stdin.on("error", () => finish(defaultYes));
    } catch (e) {
      finish(defaultYes);
      return;
    }

    setTimeout(() => {
      if (answered) return;
      process.stdout.write(`${c.dim} (超时默认 ${defaultYes ? "Y" : "N"})${c.reset}\n`);
      finish(defaultYes);
    }, timeoutMs);
  });
}

async function ackPushToServer(targetProject, appliedVersion, filesWritten) {
  try {
    await postJson(
      SERVER_URL,
      `/api/projects/${encodeURIComponent(targetProject)}/ack-push`,
      {
        applied_version: appliedVersion,
        files_written: (filesWritten || []).map((f) => path.relative(getGitRoot(), f).replace(/\\/g, "/")),
      }
    );
  } catch (e) {
    console.warn(`${c.yellow}[FlowDev-Push] ack-push 回调失败：${e?.message ?? e}${c.reset}`);
  }
}

async function cancelPushOnServer(targetProject) {
  try {
    await postJson(SERVER_URL, `/api/projects/${encodeURIComponent(targetProject)}/cancel-push`, {});
  } catch (e) {
    // Best-effort, never fatal.
  }
}

function stageFiles(filesWritten) {
  if (!filesWritten || filesWritten.length === 0) return;
  // Filter to only files that exist and are inside the git root (path-boundary safety)
  const gitRoot = getGitRoot();
  const relFiles = filesWritten
    .filter((f) => typeof f === "string" && f.length > 0)
    .map((f) => {
      try {
        const abs = path.resolve(f);
        if (!abs.startsWith(gitRoot)) return null;
        const rel = path.relative(gitRoot, abs).replace(/\\/g, "/");
        return fs.existsSync(abs) ? rel : null;
      } catch (e) {
        return null;
      }
    })
    .filter(Boolean);

  if (relFiles.length === 0) return;
  try {
    execFileSync("git", ["add", "--", ...relFiles], {
      cwd: gitRoot,
      stdio: ["pipe", "pipe", "ignore"],
    });
  } catch (e) {
    // If a user has not opted into auto-stage, surface a hint instead.
    console.warn(`${c.yellow}[FlowDev-Push] 自动 git add 失败：${e?.message ?? e}${c.reset}`);
    console.warn(`${c.dim}请手动执行: git add ${relFiles.join(" ")}${c.reset}`);
  }
}

async function checkAndPromptPush(targetProject, gitRoot, options = {}) {
  /**
   * Push Mode entry point. Calls GET /sync-status; if the server reports a
   * pending_push_version that the local repo hasn't applied yet, asks the
   * developer a one-key Y/n confirmation, then performs the sync, stages the
   * newly written files, and posts an ack back to the server.
   *
   * `options.autoApply` skips the prompt and applies immediately — used by
   * the manual --push-check --apply path so admins / devs can pull the
   * latest rule RIGHT NOW without waiting for the next commit.
   *
   * Returns the list of files written (caller may use them to git-add).
   */
  const localVersion = readLocalVersion();
  let status;
  try {
    status = await fetchSyncStatus(targetProject, localVersion);
  } catch (e) {
    if (process?.env?.FLOWDEV_PUSH_DEBUG === "1") {
      console.warn(`${c.dim}[FlowDev-Push] sync-status 查询失败：${e?.message ?? e}${c.reset}`);
    }
    return [];
  }

  if (process?.env?.FLOWDEV_PUSH_DEBUG === "1") {
    console.warn(`${c.dim}[FlowDev-Push] DEBUG pending=${status?.pending} pending_version=${status?.pending_push_version} local=${localVersion}${c.reset}`);
  }
  if (!status || !status.pending || !status.pending_push_version) {
    return [];
  }

  if (status.push_enabled === false) {
    return [];
  }

  const pendingVersion = status.pending_push_version;
  const latestVersion = status.latest_version || pendingVersion;
  if (compareSemver(pendingVersion, localVersion) <= 0) {
    // Already applied locally, just clear the flag.
    writeLocalVersion(pendingVersion);
    await ackPushToServer(targetProject, pendingVersion, []);
    return [];
  }

  const changelog = Array.isArray(status.changelog) ? status.changelog : [];
  const changeReasons = changelog
    .map((entry) => entry?.reason)
    .filter(Boolean)
    .slice(0, 5);

  console.log("");
  console.log(`${c.cyan}${c.bold}================================================================${c.reset}`);
  console.log(`${c.cyan}${c.bold} 📤 [FlowDev-Push] 检测到服务端有新的规则待推送到本地${c.reset}`);
  console.log(`${c.cyan}${c.bold}================================================================${c.reset}`);
  console.log(`  ${c.dim}本地版本:${c.reset} ${c.yellow}v${localVersion}${c.reset}`);
  console.log(`  ${c.dim}最新版本:${c.reset} ${c.green}${c.bold}v${latestVersion}${c.reset}  ${c.dim}(待推送 ${c.reset}${c.cyan}v${pendingVersion}${c.reset}${c.dim})${c.reset}`);
  if (changeReasons.length > 0) {
    console.log(`  ${c.dim}变更摘要:${c.reset}`);
    for (const r of changeReasons) {
      console.log(`    ${c.cyan}→${c.reset} ${r}`);
    }
  }
  console.log(`${c.cyan}${c.bold}================================================================${c.reset}`);

  const answer = options.autoApply
    ? true
    : await promptYesNo(
        `是否立即将 v${latestVersion} 同步到本地仓库（自动写入 AGENTS.md / .cursorrules / SKILL.md 并随本次 commit 入库）？`,
        true,
        15000
      );

  if (!answer) {
    console.log(`${c.yellow}[FlowDev-Push] 已跳过本次推送。规则不会写入本地仓库，本次 commit 正常继续。${c.reset}`);
    await cancelPushOnServer(targetProject);
    return [];
  }

  console.log(`${c.green}[FlowDev-Push] ${options.autoApply ? "已启用全自动模式，自动写入文件" : "用户已确认，开始写入文件"}...${c.reset}`);
  let filesWritten;
  try {
    filesWritten = await performSync(targetProject, gitRoot);
  } catch (e) {
    console.error(`${c.red}[FlowDev-Push] 写入文件失败：${e?.message ?? e}${c.reset}`);
    // Do NOT cancel on error: the pending push is still valid and may succeed
    // on the next commit. Just bail out for this commit.
    return [];
  }

  writeLocalVersion(latestVersion);
  stageFiles(filesWritten);
  await ackPushToServer(targetProject, latestVersion, filesWritten);

  console.log("");
  console.log(`${c.green}${c.bold}✨ Push Mode 同步完成！${c.reset}${c.dim}已自动 git add ${filesWritten.length} 个新规则文件，可随本次 commit 一起入库。${c.reset}`);
  return filesWritten;
}

async function runAutoFixCli(autoCommit = false) {
  const { projectId, branch, committer } = getGitMetadata();
  const stagedFiles = getStagedCodeFiles();
  if (!stagedFiles.length) {
    console.log(`[FlowDev-AutoFix] 暂存区为空, 无可重写文件. 请先 \`git add\` 文件.`);
    process.exit(0);
  }
  console.log(`[FlowDev-AutoFix] 项目: ${projectId}  |  暂存区: ${stagedFiles.length} 个文件`);
  console.log(`[FlowDev-AutoFix] 第一步: 扫描获取 critical + suggestions...`);
  const scan = await postJson(SERVER_URL, API_PATH, {
    project_id: projectId,
    committer,
    branch,
    files: stagedFiles.map((file) => ({
      filename: file,
      content: getStagedContent(file),
    })),
  });
  const critical = scan?.critical_issues ?? [];
  const suggestions = scan?.suggestions ?? [];
  const all = [
    ...critical.map((x) => (typeof x === "string" ? x : String(x))),
    ...suggestions.map((x) => (typeof x === "string" ? x : String(x))),
  ];
  if (!all.length) {
    console.log(`[FlowDev-AutoFix] 暂存区已合格, 无需重写.`);
    process.exit(0);
  }
  console.log(`[FlowDev-AutoFix] 第二步: AI 重写 ${stagedFiles.length} 个文件 (critical=${critical.length}, suggestions=${suggestions.length})...`);
  const result = await applySuggestionsToFiles(stagedFiles, all, projectId);
  console.log(`[FlowDev-AutoFix] 重写结果: rewritten=${result.rewritten}, skipped=${result.skipped}`);
  console.log(`[FlowDev-AutoFix] 第三步: 重新扫描验证...`);
  const rescan = await postJson(SERVER_URL, API_PATH, {
    project_id: projectId,
    committer,
    branch,
    files: stagedFiles.map((f) => ({
      filename: f,
      content: getStagedContent(f),
    })),
  });
  if (rescan?.passed) {
    console.log(`\n${c.green}[FlowDev-AutoFix] ✓ 一次重写后审查合格!${c.reset}`);
    if (autoCommit) {
      const commitMsg = process?.env?.FLOWDEV_COMMIT_MSG || "fix: AI auto-fix critical issues";
      console.log(`[FlowDev-AutoFix] 第四步: git commit -m "${commitMsg}" (跳过 hook 绕过)...`);
      try {
        safeGitExec(["commit", "-m", commitMsg, "--no-verify"], "");
        console.log(`${c.green}✓ commit 完成! 接下来 \`git push\` 即可.${c.reset}`);
        process.exit(0);
      } catch (e) {
        console.error(`git commit 失败: ${e?.message ?? e}`);
        process.exit(1);
      }
    } else {
      console.log(`${c.cyan}下一步: git commit -m "..." 重新提交${c.reset}`);
      process.exit(0);
    }
  } else {
    console.log(`${c.yellow}[FlowDev-AutoFix] ✗ 重写后仍有 ${(rescan?.critical_issues ?? []).length} 项 critical, 请手动修复${c.reset}`);
    if (Array.isArray(rescan?.critical_issues)) {
      rescan.critical_issues.forEach((iss, i) => console.log(`  [${i+1}] ${iss}`));
    }
    process.exit(1);
  }
}

async function runPushCheckCli() {
  const { projectId } = getGitMetadata();
  const targetProject = process?.env?.FLOWDEV_PROJECT_ID || projectId || "rxjs";
  const gitRoot = getGitRoot();

  // --apply (or --force / --yes) skips the Y/n prompt and applies immediately.
  // This is the **immediate sync** path: developer or admin can pull the
  // latest rule RIGHT NOW without waiting for the next commit.
  const args = process.argv.slice(2);
  const autoApply = args.includes("--apply") || args.includes("--force") || args.includes("--yes") || args.includes("-y");

  console.log(`${c.cyan}${c.bold} [FlowDev-Push] 手动检查是否有新规则待推送...${c.reset}`);
  const filesWritten = await checkAndPromptPush(targetProject, gitRoot, { autoApply });
  if (!filesWritten || filesWritten.length === 0) {
    console.log(`${c.green}[FlowDev-Push] 本地与服务端已同步，无需处理。${c.reset}`);
  } else {
    console.log(`${c.green}[FlowDev-Push] ${c.bold}✓ 已立即同步 ${filesWritten.length} 个规则文件${c.reset}`);
  }
  process.exit(0);
}

function handleCliCommands() {
  const args = process.argv.slice(2);
  const { committer } = getGitMetadata();

  // --config: interactive preferences editor (or one-shot via --auto-apply)
  if (args.includes("--config") || args.includes("config")) {
    const forceAuto = args.includes("--auto-apply") || args.includes("--full-auto");
    const forceAsk = args.includes("--ask-each") || args.includes("--interactive");
    const forceAiRewrite = args.includes("--ai-rewrite") || args.includes("--auto-ai");
    if (forceAuto) {
      savePreferences({ push: { autoApply: true, enabled: true }, upgrade: { auto: true } });
      console.log(`${c.green}✓ 已切换为全自动模式 (服务端推送 / hook 升级均无询问)${c.reset}`);
      process.exit(0);
    }
    if (forceAsk) {
      savePreferences({ push: { autoApply: false, enabled: true }, upgrade: { auto: true } });
      console.log(`${c.green}✓ 已切换为询问模式 (遇到新规则时 Y/n 询问)${c.reset}`);
      process.exit(0);
    }
    if (forceAiRewrite) {
      savePreferences({ suggestions: { autoApply: true } });
      console.log(`${c.green}✓ 已启用 AI 自动重写: 审查后立即调用 LLM 重写代码 (无询问)${c.reset}`);
      process.exit(0);
    }
    const cur = loadPreferences();
    console.log("");
    console.log(`${c.cyan}${c.bold}FlowDev 本地偏好 (当前仓库)${c.reset}`);
    console.log(`  push.autoApply       : ${cur.pushAutoApply ? c.green + "✓ 全自动 (不询问)" : c.yellow + "🟡 询问 Y/n (默认 Y)"}`);
    console.log(`  push.enabled         : ${cur.pushEnabled ? c.green + "✓ 开启" : c.red + "✗ 关闭"}`);
    console.log(`  upgrade.auto         : ${cur.autoUpgrade ? c.green + "✓ 自动升级 hook" : c.yellow + "✗ 仅检查"}`);
    console.log(`  strict.offline       : ${cur.strictOffline ? c.red + "✗ 后端不可达阻断" : c.green + "✓ 降级放行"}`);
    console.log(`  suggestions.autoApply: ${cur.suggestionsAutoApply ? c.green + "✓ AI 自动重写文件 (无询问)" : c.yellow + "🟡 询问是否让我让 AI 重写 (默认 Y)"}`);
    console.log("");
    console.log(`${c.dim}快速切换:${c.reset}`);
    console.log(`  ${c.cyan}node .git/hooks/pre-commit --config --auto-apply${c.reset}        全自动模式`);
    console.log(`  ${c.cyan}node .git/hooks/pre-commit --config --ask-each${c.reset}         询问模式 (默认)`);
    console.log(`  ${c.cyan}node .git/hooks/pre-commit --config --ai-rewrite${c.reset}      AI 自动重写建议 (无询问)`);
    console.log("");
    process.exit(0);
  }

  if (args.includes("--disable") || args.includes("disable") || args.includes("--off")) {
    try {
      gitExec(["config", "flowdev.enabled", "false"]);
      logBypassAudit("CLI --disable bypass", committer);
      console.log(`\n${c.green}✔ 已成功关闭当前仓库的 FlowDev 门禁！${c.reset}`);
      console.log(`${c.dim}后续 git commit 将完全跳过门禁检查，秒速直接提交。${c.reset}`);
      console.log(`如需重新开启门禁，请运行: ${c.cyan}node .git/hooks/pre-commit --enable${c.reset}\n`);
      process.exit(0);
    } catch (e) {
      console.error("执行 git config 失败:", e?.message ?? e);
      process.exit(1);
    }
  }

  if (args.includes("--enable") || args.includes("enable") || args.includes("--on")) {
    try {
      gitExec(["config", "flowdev.enabled", "true"]);
      console.log(`\n${c.green}✔ 已成功恢复 FlowDev 代码安全门禁！${c.reset}`);
      console.log(`${c.dim}提交时将进行智能审查与防空指针拦截。${c.reset}\n`);
      process.exit(0);
    } catch (e) {
      console.error("执行 git config 失败:", e?.message ?? e);
      process.exit(1);
    }
  }

  if (args.includes("--warn") || args.includes("--warn-only") || args.includes("warn")) {
    try {
      gitExec(["config", "flowdev.enabled", "true"]);
      gitExec(["config", "flowdev.mode", "warn"]);
      logBypassAudit("CLI --warn mode switched", committer);
      console.log(`\n${c.green}✔ 已切换为「仅告警不阻断 (Warn Only)」模式！${c.reset}`);
      console.log(`${c.dim}AI 审查建议照常输出，但 100% 自动放行提交，绝不卡住你的开发进度！${c.reset}`);
      console.log(`如需恢复严格阻断，请运行: ${c.cyan}node .git/hooks/pre-commit --block${c.reset}\n`);
      process.exit(0);
    } catch (e) {
      console.error("执行 git config 失败:", e?.message ?? e);
      process.exit(1);
    }
  }

  if (args.includes("--block") || args.includes("block")) {
    try {
      gitExec(["config", "flowdev.enabled", "true"]);
      gitExec(["config", "flowdev.mode", "block"]);
      console.log(`\n${c.green}✔ 已切换为「严格阻断 (Block)」模式！${c.reset}`);
      console.log(`${c.dim}检测到致命缺陷将拦截 Commit，确保仓库代码质量。${c.reset}\n`);
      process.exit(0);
    } catch (e) {
      console.error("执行 git config 失败:", e?.message ?? e);
      process.exit(1);
    }
  }

  if (args.includes("--status") || args.includes("status")) {
    const enabled = safeGitExec(["config", "--get", "flowdev.enabled"], "true");
    const mode = safeGitExec(["config", "--get", "flowdev.mode"], "block");

    const isEnabled = enabled !== "false" && enabled !== "0" && enabled !== "off";
    console.log(`\n${c.cyan}=== FlowDev Git Hook 本地配置状态 ===${c.reset}`);
    console.log(`门禁总开关: ${isEnabled ? c.green + "已开启 (ON)" : c.yellow + "已关闭 (OFF) - 秒级直接提交"}${c.reset}`);
    console.log(`本地模式: ${mode === "warn" ? c.yellow + "仅提示不阻断 (Warn Only)" : c.red + "严格阻断 (Block)"}${c.reset}`);
    console.log(`门禁中台: ${SERVER_URL}`);
    console.log(`\n快捷管理指令:`);
    console.log(`  node .git/hooks/pre-commit --warn        (推荐开发期：仅提示，不卡提交)`);
    console.log(`  node .git/hooks/pre-commit --disable     (完全关闭门禁)`);
    console.log(`  node .git/hooks/pre-commit --enable      (恢复严格门禁)`);
    console.log(`  node .git/hooks/pre-commit --push-check  (检查后端是否有新规则待推送，并提示确认同步)`);
    console.log(`  node .git/hooks/pre-commit --push-check --apply  (不等 commit, 立即应用)`);
    console.log(`  node .git/hooks/pre-commit --sync        (同 --push-check --apply, 立即同步)`);
    console.log(`  node .git/hooks/pre-commit --upgrade     (立即检查 hook 版本并自升级)`);
    console.log(`  git commit -m "..." --no-verify         (原生单次跳过)\n`);
    process.exit(0);
  }
}

// =============================================================================
//  Auto-Upgrade: Hook fetches server's latest version on startup and replaces
//  itself when out of date. This is how we avoid asking admins to `cp` the
//  script to every project. The user/developer never has to do anything.
// =============================================================================

// == HANDBOOK: hook-self-upgrade ==
//
// 每次 hook 启动时, 自检服务端 `/api/hook/version`, 发现新版本则:
//   1. 下载 `/scripts/flowdev-hook.js` 全文
//   2. 备份当前 hook 到 `.git/hooks/pre-commit.bak`
//   3. 写入新版本到当前 hook
//   4. `spawnSync` 重新跑一遍新 hook
//   5. 失败自动回滚
//
// **对开发者完全透明**: 团队升级 hook 无需任何运维操作, 下次 commit 自动用新版。
//
// 手动触发: `node .git/hooks/pre-commit --upgrade`
// 服务端版本端点: `GET /api/hook/version` → `{version, sha, size, download_url}`
// 备份文件: `.git/hooks/pre-commit.bak` (每次升级覆写)
// == /HANDBOOK ==

function readLocalHookVersion() {
  // Stored in .git/flowdev/.hook-version so we don't have to grep the script.
  // First-time installs have no version recorded yet; treat that as 0.0.0 so
  // the first commit triggers a "self-check-in" upgrade.
  try {
    const p = path.join(getGitRoot(), ".git", "flowdev", ".hook-version");
    if (fs.existsSync(p)) return fs.readFileSync(p, "utf-8").trim();
  } catch (e) {}
  return "0.0.0";
}

function writeLocalHookVersion(v) {
  try {
    const dir = path.join(getGitRoot(), ".git", "flowdev");
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(path.join(dir, ".hook-version"), String(v), "utf-8");
  } catch (e) {}
}

function compareSemver(a, b) {
  const pa = String(a).split(".").map((n) => parseInt(n, 10) || 0);
  const pb = String(b).split(".").map((n) => parseInt(n, 10) || 0);
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const da = pa[i] || 0;
    const db = pb[i] || 0;
    if (da > db) return 1;
    if (da < db) return -1;
  }
  return 0;
}

async function fetchServerHookVersion() {
  // Talks to backend /api/hook/version. Returns { version, sha } or null on
  // any failure. We treat any error as "unknown" so a down server doesn't
  // block commits — same fail-open philosophy as the rest of the hook.
  try {
    const url = new URL(HOOK_VERSION_API, SERVER_URL).toString();
    const res = await fetchJson(url, {}, 3000);
    if (res && res.version) return res;
  } catch (e) {}
  return null;
}

async function downloadLatestHook() {
  // Pulls the actual JS from /scripts/flowdev-hook.js (the same endpoint
  // admins use to install fresh). Returns the script text or null.
  // NOTE: server returns plain text (application/javascript), NOT JSON, so
  // we must use fetchText() here — JSON.parse would throw on a JS source.
  try {
    const url = new URL("/scripts/flowdev-hook.js", SERVER_URL).toString();
    const text = await fetchText(url, 5000);
    if (text && typeof text === "string" && text.includes("FlowDev-AI Pre-Commit")) {
      return text;
    }
  } catch (e) {}
  return null;
}

async function maybeSelfUpgrade() {
  // Only attempt upgrade if we can find where this script lives on disk.
  // When invoked via `node .git/hooks/pre-commit` __filename is the hook.
  const scriptPath = __filename;
  if (!scriptPath || !fs.existsSync(scriptPath)) return;

  const localVersion = readLocalHookVersion();
  const server = await fetchServerHookVersion();
  if (!server || !server.version) {
    if (process?.env?.FLOWDEV_DEBUG) console.log(`[FlowDev-Upgrade] server unreachable, fail-open`);
    return; // fail-open: server unreachable
  }
  if (compareSemver(server.version, localVersion) <= 0) {
    if (process?.env?.FLOWDEV_DEBUG) console.log(`[FlowDev-Upgrade] already at v${localVersion}, no upgrade needed`);
    return; // up to date
  }
  if (process?.env?.FLOWDEV_DEBUG) {
    console.log(`[FlowDev-Upgrade] upgrade needed: local=v${localVersion} → server=v${server.version}`);
  }

  // Server is newer — download + backup + replace + re-exec.
  const newScript = await downloadLatestHook();
  if (!newScript) {
    if (process?.env?.FLOWDEV_DEBUG) console.log(`[FlowDev-Upgrade] download failed`);
    return;
  }

  try {
    const bakPath = scriptPath + ".bak";
    if (fs.existsSync(scriptPath)) {
      try { fs.copyFileSync(scriptPath, bakPath); } catch (e) {}
    }
    fs.writeFileSync(scriptPath, newScript, "utf-8");
    writeLocalHookVersion(server.version);
    console.log(`${c.cyan}[FlowDev-Upgrade] ${c.bold}Hook 已自动升级 v${localVersion} → v${server.version}${c.reset}`);
    console.log(`${c.dim}  备份: ${scriptPath}.bak   |   下载: ${server.sha}${c.reset}`);
    // Re-exec the freshly-downloaded hook so the rest of main() uses new code.
    const { spawnSync } = require("child_process");
    const r = spawnSync(process.execPath, [scriptPath, ...process.argv.slice(2)], {
      stdio: "inherit",
      env: process.env,
    });
    process.exit(r.status ?? 0);
  } catch (e) {
    if (process?.env?.FLOWDEV_DEBUG) console.log(`[FlowDev-Upgrade] write/exec failed: ${e?.message}`);
    // Rollback on any failure so we don't leave a half-broken hook.
    try {
      if (fs.existsSync(scriptPath + ".bak")) {
        fs.copyFileSync(scriptPath + ".bak", scriptPath);
      }
    } catch (_) {}
  }
}

async function main() {
  // Self-upgrade FIRST, before any other logic. Failures here are silent
  // so a misbehaving server can never block legitimate commits.
  try { await maybeSelfUpgrade(); } catch (e) {}

  // Auto-regenerate docs/HANDBOOK.md if any source comment changed. This
  // keeps the usage manual in lock-step with the code so we never have to
  // remember to update it manually. Failures are silent so a developer
  // whose Node version lacks fs writes won't be blocked.
  try {
    const { execFileSync } = require("child_process");
    const genScript = path.join(getFlowDevRepoRoot(), "docs", "gen-handbook.js");
    if (fs.existsSync(genScript)) {
      execFileSync(process.execPath, [genScript], { stdio: "ignore" });
    }
  } catch (e) {}

  const { projectId, branch, committer } = getGitMetadata();

  // First-run setup wizard: ask once, persist to .config.json, never ask again.
  // Skip in non-TTY (CI/VS Code GUI) — adopt sensible defaults so devs aren't
  // trapped by silent commits.
  const prefs = loadPreferences();
  const cfgFile = path.join(getGitRoot(), ".git", "flowdev", ".config.json");
  if (!fs.existsSync(cfgFile) && process?.stdin?.isTTY && process?.stdout?.isTTY) {
    try {
      const freshPrefs = await runSetupWizard();
      Object.assign(prefs, freshPrefs);
    } catch (e) {}
  }

  // Support quick environment bypass
  if (process?.env?.FLOWDEV_DISABLE === "1" || process?.env?.FLOWDEV_BYPASS === "1" || process?.env?.SKIP_FLOWDEV === "1") {
    logBypassAudit("ENV FLOWDEV_DISABLE / BYPASS", committer);
    console.log(`${c.yellow}[FlowDev-AI] 检测到环境变量 FLOWDEV_DISABLE，已快速跳过门禁放行提交。${c.reset}`);
    process.exit(0);
  }

  // Support local git config bypass
  const localConfigEnabled = safeGitExec(["config", "--get", "flowdev.enabled"], "").toLowerCase();
  if (localConfigEnabled === "false" || localConfigEnabled === "0" || localConfigEnabled === "off" || localConfigEnabled === "no") {
    logBypassAudit("git config flowdev.enabled=false", committer);
    console.log(`${c.yellow}[FlowDev-AI] 当前仓库已通过 git config 关闭门禁，快速跳过审查放行提交。${c.reset}`);
    process.exit(0);
  }

  // ============== Push Mode: pre-flight pending-push check ==============
  // Asks the server whether a newer rule set is staged and awaiting local
  // confirmation. Runs before the staged-files gate so the user gets the
  // prompt first, then continues with the regular commit flow.
  const gitRoot = getGitRoot();
  try {
    const envPushOff =
      process?.env?.FLOWDEV_DISABLE_PUSH === "1" || process?.env?.FLOWDEV_SKIP_PUSH === "1";
    const localPushOff = safeGitExec(["config", "--get", "flowdev.pushmode"], "").toLowerCase();
    const pushEnabled =
      !envPushOff && localPushOff !== "false" && localPushOff !== "0" && localPushOff !== "off";
    if (pushEnabled) {
      // User preferences drive whether to prompt. pushAutoApply=true skips
      // the Y/n and writes files immediately — the desired "zero-confirm"
      // UX once the dev has expressed trust.
      const opts = prefs?.pushAutoApply ? { autoApply: true } : {};
      await checkAndPromptPush(projectId, gitRoot, opts);
    }
  } catch (e) {
    if (process?.env?.FLOWDEV_PUSH_DEBUG === "1") {
      console.warn(`${c.dim}[FlowDev-Push] 检查异常跳过：${e?.message ?? e}${c.reset}`);
    }
  }

  const stagedFiles = getStagedCodeFiles();

  // If no code changes in staged index, allow commit with helpful feedback
  if (!stagedFiles || stagedFiles.length === 0) {
    const allStaged = safeGitExec(["diff", "--cached", "--name-only"], "");
    if (allStaged && allStaged.trim().length > 0) {
      console.log(
        `${c.dim}[FlowDev-AI 门禁] 暂存区均为文档或配置等非核心源码文件，已自动放行提交。${c.reset}`
      );
    } else if (process?.stdout?.isTTY) {
      console.log(
        `\n${c.cyan}[FlowDev-AI 门禁就绪]${c.reset} 钩子探针正常运行中，当前暂存区无待审查代码。`
      );
      console.log(
        `${c.dim}提示: 在项目中修改代码并通过 'git add <文件>' 暂存后，执行 'git commit' 即可自动触发 AI 质量门禁。${c.reset}\n`
      );
    }
    process.exit(0);
  }

  printBanner();
  console.log(
    `\n[扫描] [${c.cyan}${projectId}${c.reset} / ${c.yellow}${branch}${c.reset}] 暂存区包含 ${c.bold}${stagedFiles.length}${c.reset} 个待提交源码文件:`
  );
  stagedFiles.forEach((f) => console.log(`   - ${f}`));

  console.log(
    `\n[审查中] 正在将暂存代码交由 ${c.magenta}ReviewAgent${c.reset} 审查并在 ${c.blue}TestSandbox${c.reset} 中运行验证...`
  );

  const filesPayload = stagedFiles.map((file) => ({
    filename: file,
    content: getStagedContent(file),
  }));

  let scanResult;
  try {
    scanResult = await postJson(SERVER_URL, API_PATH, {
      project_id: projectId,
      committer,
      branch,
      files: filesPayload,
    });
  } catch (err) {
    const isStrict = process?.env?.FLOWDEV_STRICT === "1";
    if (isStrict) {
      console.error(
        `\n${c.yellow}[FlowDev-AI 警告] 无法连接到门禁服务 (${SERVER_URL})${c.reset}`
      );
      console.error(`   原因: ${err?.message ?? err}`);
      console.error(
        `   提示: 当前处于严格门禁模式 (FLOWDEV_STRICT=1)，阻断提交。\n`
      );
      process.exit(1);
    } else {
      console.warn(
        `\n${c.yellow}[FlowDev-AI 提示] 无法连接到门禁服务 (${SERVER_URL}): ${err?.message ?? err}${c.reset}`
      );
      console.warn(
        `   降级策略: 本地无阻断放行提交。如需强制拦截请设置 export FLOWDEV_STRICT=1\n`
      );
      process.exit(0);
    }
  }

  console.log(
    "\n----------------------------------------------------------------"
  );

  if (scanResult?.passed) {
    // Passed successfully! Make it loud so the developer actually notices
    // that the gatekeeper ran (vs. silently allowing the commit through).
    if (isColorSupported) {
      console.log("");
      console.log(`${c.bgGreen}${c.bold}                                                                ${c.reset}`);
      console.log(`${c.bgGreen}${c.bold}   ✅ [FlowDev 门禁通过] 质量审查合格, 单测自愈验证通过, 允许提交! ${c.reset}`);
      console.log(`${c.bgGreen}${c.bold}                                                                ${c.reset}`);
      console.log(`${c.dim}   📊 ${scanResult?.summary ?? "AI 多 Agent 审查 + TestAgent 沙箱闭环验证通过"}${c.reset}`);
      console.log(`${c.dim}   🛡️  ${scanResult?.files_count ?? stagedFiles.length} 个源码文件经 ReviewAgent / TestAgent 双重验证${c.reset}`);
      console.log(`${c.dim}   🚀  本次 commit 安全入库, 团队 pull 后全员受益${c.reset}`);
    } else {
      console.log(`[FlowDev 门禁通过] 质量审查合格, 单测自愈验证通过, 允许提交!`);
      console.log(`  ${scanResult?.summary ?? ""}`);
    }

    const suggestions = scanResult?.suggestions ?? [];
    if (suggestions.length > 0) {
      console.log(`\n${c.cyan}[建议] 优化建议 (非阻断项, 强烈建议采纳):${c.reset}`);
      suggestions.forEach((sug, i) => {
        console.log(`   ${c.dim}${i + 1}.${c.reset} ${sug}`);
      });

      // === AUTO-APPLY SUGGESTIONS (AI 帮你改代码) ===
      // Ask once: "Want me to rewrite these files for you?" Default Y.
      // When confirmed, for every staged source file we POST its content +
      // the suggestion list to /api/cli/apply-suggestions. The backend LLM
      // returns the fully rewritten file; we write it back, git-add it, and
      // let the commit proceed with AI-improved code.
      const autoApply = prefs?.suggestionsAutoApply === true;
      const ans = autoApply
        ? true
        : await promptYesNo(
            `AI 可根据以上 ${suggestions.length} 项建议自动重写代码, 让它现在动手吗?`,
            true,
            20000
          );

      if (ans) {
        await applySuggestionsToFiles(stagedFiles, suggestions, projectId);
      } else {
        console.log(`${c.dim}[FlowDev-AI] 跳过 AI 自动重写, 按现有代码提交。${c.reset}`);
      }
    }

    if (isColorSupported) {
      console.log(
        "\n----------------------------------------------------------------\n"
      );
    }
    process.exit(0);
  } else {
    // Check if local repo is configured for warn-only mode
    let isWarnOnly = false;
    const localMode = safeGitExec(["config", "--get", "flowdev.mode"], "").toLowerCase();
    if (localMode === "warn" || localMode === "warn_only") isWarnOnly = true;
    if (process?.env?.FLOWDEV_WARN === "1" || process?.env?.FLOWDEV_WARN_ONLY === "1") isWarnOnly = true;

    const criticalIssues = scanResult?.critical_issues ?? [];
    const suggestions = scanResult?.suggestions ?? [];

    if (isWarnOnly) {
      logBypassAudit("Warn-only mode pass", committer);
      console.log(`\n${c.yellow}================================================================${c.reset}`);
      console.log(`${c.yellow}[FlowDev 提示] 检测到潜在缺陷，但当前处于「仅提示不拦截 (Warn Only)」模式，已放行本次提交！${c.reset}`);
      if (criticalIssues.length > 0) {
        console.log(`${c.red}待关注隐患:${c.reset}`);
        criticalIssues.forEach((iss) => console.log(`  • ${iss}`));
      }
      if (suggestions.length > 0) {
        console.log(`${c.cyan}优化建议:${c.reset}`);
        suggestions.forEach((sug) => console.log(`  - ${sug}`));
      }
      console.log(`${c.yellow}================================================================\n${c.reset}`);
      process.exit(0);
    }

    // Intercepted!
    const issueCount = criticalIssues.length;

    // === VS Code Git GUI 弹窗适配 ===
    // VS Code Git extension 在 commit 失败时:
    //   - 显示一个模态弹窗, 内容是 hook 的 stderr 输出
    //   - Git OUTPUT 面板会捕获 hook 的全部 stdout + stderr
    // 为了在两者中都好看, 我们分流:
    //   * stderr = 精简版 (弹窗)
    //   * stdout = 详细 issues 完整列表 (OUTPUT 面板 Git channel)
    // VS Code 检测启发式: git 在 hook 中设的 env + 父进程是 git.exe 但命令行含 user.useConfigOnly=true (VS Code 特征)
    const isVSCode =
      !!process?.env?.VSCODE_GIT_ASKPASS_PIPE
      || !!process?.env?.VSCODE_GIT_ASKPASS
      || !!process?.env?.VSCODE_GIT_IPC_HANDLE
      || !!process?.env?.VSCODE_PID
      || !!process?.env?.VSCODE_CWD
      || process?.env?.TERM_PROGRAM === "vscode";
    if (process?.env?.FLOWDEV_DEBUG === "1") {
      console.error(`[FlowDev Debug] isVSCode=${isVSCode}`);
      console.error(`[FlowDev Debug] VSCODE_GIT_ASKPASS_PIPE=${process?.env?.VSCODE_GIT_ASKPASS_PIPE || "<unset>"}`);
      console.error(`[FlowDev Debug] VSCODE_GIT_ASKPASS=${process?.env?.VSCODE_GIT_ASKPASS || "<unset>"}`);
      console.error(`[FlowDev Debug] VSCODE_GIT_IPC_HANDLE=${process?.env?.VSCODE_GIT_IPC_HANDLE || "<unset>"}`);
      console.error(`[FlowDev Debug] VSCODE_PID=${process?.env?.VSCODE_PID || "<unset>"}`);
      console.error(`[FlowDev Debug] TERM_PROGRAM=${process?.env?.TERM_PROGRAM || "<unset>"}`);
    }
    if (isVSCode) {
      // 把详细 issues 写日志 (VS Code 弹窗里看不到全部)
      try {
        const logPath = path.join(getGitRoot(), ".git", "flowdev", ".last-scan.log");
        const logLines = [
          `=========================================================`,
          `FlowDev-AI 扫描报告 - ${new Date().toISOString()}`,
          `项目: ${projectId}  分支: ${branch}  作者: ${committer}`,
          `暂存区: ${stagedFiles.join(", ")}`,
          `=========================================================`,
          ``,
          `[原因] ${scanResult?.summary ?? "检测到关键代码缺陷"}`,
          ``,
          `【阻断性致命缺陷】(共 ${criticalIssues.length} 项)`,
          ...criticalIssues.map((iss, i) => `  [${i+1}] ${iss}`),
          ``,
          `【修复建议】(共 ${suggestions.length} 项)`,
          ...suggestions.map((sug, i) => `  [${i+1}] ${sug}`),
          ``,
          `=========================================================`,
          `修复方式:`,
          `  cd ${getGitRoot()}`,
          `  node .git/hooks/pre-commit --auto-fix         (AI 重写代码)`,
          `  node .git/hooks/pre-commit --auto-fix --commit (AI 重写后自动 commit)`,
          `=========================================================`,
        ];
        fs.writeFileSync(logPath, logLines.join("\n"), "utf-8");
      } catch (e) {}
    }

    // 第一行: stderr 进 VS Code 弹窗 (标题)
    console.error(
      `[FlowDev] ❌ 门禁拦截: ${issueCount} 项致命缺陷 + ${suggestions.length} 项建议`
    );

    // === stderr: 精简版 (VS Code 弹窗) ===
    console.error("");
    console.error("❌ 阻断原因 (按文件汇总):");
    const byFile = {};
    criticalIssues.forEach((iss) => {
      const m = String(iss).match(/\[([^\]]+)\]/);
      const f = m ? m[1] : "(其他)";
      if (!byFile[f]) byFile[f] = 0;
      byFile[f]++;
    });
    Object.entries(byFile).forEach(([file, n]) => {
      console.error(`   • ${file}  (${n} 项问题)`);
    });
    console.error("");
    console.error("✅ 修复方式 (二选一):");
    console.error(`   1. AI 自动重写:  cd "${getGitRoot()}"  &&  node .git/hooks/pre-commit --auto-fix`);
    console.error(`   2. 紧急跳过门禁:  git commit -m "..." --no-verify`);
    console.error("");
    console.error(`📄 详细 issues 见 Git OUTPUT panel`);

    // === stdout: 详细 issues 完整列表 (Git channel OUTPUT 面板) ===
    console.log("");
    console.log("================================================================");
    console.log("  FlowDev-AI 详细扫描报告 (VS Code: 在 OUTPUT 面板的 Git channel 查看)");
    console.log("================================================================");
    console.log(`项目: ${projectId}  分支: ${branch}  作者: ${committer}`);
    console.log(`暂存区: ${stagedFiles.join(", ")}`);
    console.log(`原因: ${scanResult?.summary ?? "检测到关键代码缺陷"}`);
    console.log("");
    console.log(`❌ 【阻断性致命缺陷】(共 ${criticalIssues.length} 项)`);
    criticalIssues.forEach((iss, idx) => {
      console.log(`  [${idx + 1}] ${iss}`);
    });
    if (suggestions.length > 0) {
      console.log("");
      console.log(`💡 【修复建议】(共 ${suggestions.length} 项)`);
      suggestions.forEach((sug, idx) => {
        console.log(`  [${idx + 1}] ${sug}`);
      });
    }
    console.log("");
    console.log("================================================================");
    console.log("➡️ [下一步] 修复 critical 后重试, 或运行 AI 自动改写:");
    console.log(`   node .git/hooks/pre-commit --auto-fix`);
    console.log(`   node .git/hooks/pre-commit --auto-fix --commit`);
    console.log(`   git commit -m "..." --no-verify`);
    console.log("================================================================");
    console.log("");
    process.exit(1);
  }
}

// 1. Check CLI management subcommands (--disable, --enable, --warn, --status)
handleCliCommands();

// 2. Main execution / skills sync
if (process.argv.includes("--sync-skills") || process.argv.includes("-s") || process.argv.includes("sync")) {
  syncSkills().catch((err) => {
    console.error("同步 Agent Skills 失败:", err?.message ?? err);
    process.exit(1);
  });
} else if (process.argv.includes("--push-check") || process.argv.includes("push-check")) {
  runPushCheckCli().catch((err) => {
    console.error("[FlowDev-Push] 推送检查失败:", err?.message ?? err);
    process.exit(1);
  });
} else if (process.argv.includes("--sync") || process.argv.includes("sync-rules")) {
  // --sync / --sync-rules = 立即同步 (跳过询问), 适用场景:
  //   1. 守门员沉淀后需要各本地仓库立刻拉到 (不等 commit)
  //   2. 开发者主动 curl 最新规则
  //   3. CI 启动前预热本地 IDE 规则文件
  process.argv.push("--apply");  // 强制跳过 prompt
  runPushCheckCli().catch((err) => {
    console.error("[FlowDev-Sync] 立即同步失败:", err?.message ?? err);
    process.exit(1);
  });
} else if (process.argv.includes("--auto-fix") || process.argv.includes("auto-fix") || process.argv.includes("fix")) {
  // Standalone AI rewrite + re-scan. Run AFTER a failed commit when critical
  // issues blocked it. By default only rewrites + re-scans; with --commit
  // it also commits automatically once clean.
  runAutoFixCli(process.argv.includes("--commit")).catch((err) => {
    console.error("[FlowDev-AutoFix] 失败:", err?.message ?? err);
    process.exit(1);
  });
} else if (process.argv.includes("--upgrade") || process.argv.includes("upgrade")) {
  // Manual upgrade subcommand: forces a self-upgrade regardless of version.
  (async () => {
    console.log(`${c.cyan}[FlowDev-Upgrade] 手动触发升级检查...${c.reset}`);
    const before = readLocalHookVersion();
    const server = await fetchServerHookVersion();
    if (!server) {
      console.log(`${c.red}[FlowDev-Upgrade] 无法连接服务器, 升级失败${c.reset}`);
      process.exit(1);
    }
    console.log(`${c.dim}  本地版本: ${before}${c.reset}`);
    console.log(`${c.dim}  服务器版本: ${server.version}${c.reset}`);
    if (compareSemver(server.version, before) <= 0) {
      console.log(`${c.green}[FlowDev-Upgrade] 已经是最新版本, 无需升级${c.reset}`);
      process.exit(0);
    }
    const newScript = await downloadLatestHook();
    if (!newScript) {
      console.log(`${c.red}[FlowDev-Upgrade] 下载新版本失败${c.reset}`);
      process.exit(1);
    }
    try {
      const scriptPath = __filename;
      if (fs.existsSync(scriptPath)) {
        try { fs.copyFileSync(scriptPath, scriptPath + ".bak"); } catch (e) {}
      }
      fs.writeFileSync(scriptPath, newScript, "utf-8");
      writeLocalHookVersion(server.version);
      console.log(`${c.green}[FlowDev-Upgrade] 升级成功! 当前版本: v${server.version}${c.reset}`);
      console.log(`${c.dim}  备份旧版: ${__filename}.bak${c.reset}`);
      process.exit(0);
    } catch (e) {
      console.error(`${c.red}[FlowDev-Upgrade] 写入失败: ${e?.message ?? e}${c.reset}`);
      process.exit(1);
    }
  })();
} else {
  main().catch((err) => {
    console.error("执行 FlowDev 门禁检查发生未捕获异常:", err?.message ?? err);
    process.exit(1);
  });
}
