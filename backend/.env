# FlowDev-AI LLM Configuration
# 用户可在此填写真实 API Key，未填写时系统自动进入智能自适应仿真模式
OPENAI_API_BASE=https://tokenerpgw.asiainfo.com/erp/v1
OPENAI_API_KEY=
DEFAULT_MODEL=AI/deekseek-v4-flash-0731
REQUEST_TIMEOUT=60

# 飞书群自定义机器人 Webhook 配置
# 可在飞书群设置 -> 群机器人 -> 自定义机器人中获取 Webhook 地址
FEISHU_WEBHOOK_URL=
FEISHU_NOTIFY_ONLY_BLOCKED=true
